/// url = 'http://hl7.org/fhir/uv/omop/StructureMap/PersonMap'
/// name = 'PersonMap'
/// title = 'Mapping Patient resource to Person OMOP Domain'
/// status = 'draft'

uses "http://hl7.org/fhir/StructureDefinition/Patient" alias Patient as source
uses "http://hl7.org/fhir/uv/omop/StructureDefinition/Person" alias PersonTable as target

group Person(source src : Patient, target tgt : PersonTable) {

  src.id as id -> tgt.person_source_value = id, tgt.person_id = '1' "omop-person-id";

  src.gender as gender ->
    tgt.gender_concept_id = translate(gender, 'http://hl7.org/fhir/uv/omop/ConceptMap/GenderClass', 'code'),
    tgt.gender_source_value = gender;

  src where (src.gender.empty()) ->
    tgt.gender_concept_id = '0',
    tgt.gender_source_value = 'unknown' "nogender";

  src.birthDate as bdSrc ->
    tgt.birth_datetime = bdSrc,
    tgt.year_of_birth = (bdSrc.toString().substring(0, 4)),
    tgt.month_of_birth = (bdSrc.toString().substring(5, 2)),
    tgt.day_of_birth = (bdSrc.toString().substring(8, 2));

}
